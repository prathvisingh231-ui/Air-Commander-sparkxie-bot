DISCORD_TOKEN=your_discord_bot_token
GUILD_ID=your_test_server_id
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Discord OAuth2 application credentials (same application as the bot)
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
# Use a long random secret; keep private and set it in Render Environment.
DASHBOARD_SECRET_KEY=generate_a_long_random_secret
# Exact public Render URL, without a trailing slash
DASHBOARD_BASE_URL=https://air-commander-sparkxie-bot.onrender.com
DASHBOARD_COOKIE_SECURE=true
